# با این فرمان می‌توانید به‌جای پر کردن دستی، سؤال‌به‌سؤال بسازیدش:
#   python -m froshgah setup
# (رمزها فقط در همین رایانه می‌مانند؛ هرگز آن‌ها را در چت یا ایمیل نفرستید)

# ————— ربات تلگرام —————
# توکن ربات را از @BotFather بگیرید
TELEGRAM_BOT_TOKEN=
# شناسه عددی خودتان (از @userinfobot یا @getmyidbot)
TELEGRAM_OWNER_ID=

# ————— تلگرام MTProto (سرور API خود تلگرام) —————
# از my.telegram.org → API Development Tools
TG_API_ID=
TG_API_HASH=
# مسیر فایل سشن (اختیاری)
# TG_SESSION_PATH=

# ————— اینستاگرام (اختیاری اما توصیه‌شده) —————
IG_USERNAME=
IG_PASSWORD=

# ————— تنظیمات دیگر —————
# DB_PATH=froshgah.db
# فاصله بین درخواست‌ها به ثانیه (هرچه بیشتر = امن‌تر)
REQUEST_DELAY=1.5
